# Provider — these three values are the ONLY difference between a model
# running on your laptop and one running in a datacentre. Copy to .env.
#
# Ollama (local, unlimited, no signup):
LLM_BASE_URL=http://localhost:11434/v1/
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b     # llama3.2:1b was tried first and could not follow a plain instruction — see README
#
# OpenRouter (hosted, 50 requests/day free) — swap to these three instead:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...your key...
# LLM_MODEL=openrouter/free

# Reliability
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3

# Switches
LLM_ENABLED=true    # false -> endpoint returns 503, zero model calls (kill switch)
LLM_STUB=0          # 1     -> endpoint returns a canned valid answer, zero model calls
LLM_WARMUP=true          # load the model at startup so the first caller does not pay cold start
LLM_DEADLINE_SECONDS=90  # max total wall time one request may spend across retries
LLM_WARMUP_TIMEOUT_SECONDS=600   # boot-time warm-up budget; nobody is waiting

# Prompt
LLM_PROMPT_VERSION=enrich-v2   # which file in prompts/ is the system prompt; enrich-v1 is kept for comparison
